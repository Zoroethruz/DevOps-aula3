
name: CD

on:
  push:
    branches: ["main", "código"]
    tags: ["v*"]

permissions:
  contents: read
  packages: write

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar codigo
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Instalar dependencias
        run: pip install -r requirements-dev.txt

      - name: Executar testes
        run: pytest tests/ -v

      - name: Criar imagem Docker
        run: docker build -t hotel-api .

      - name: Login no GHCR
        run: echo "${{ github.token }}" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin

      - name: Publicar imagem
        run: |
          IMAGE="ghcr.io/${GITHUB_REPOSITORY,,}"
          VERSION="${GITHUB_SHA::7}"

          if [[ "$GITHUB_REF" == refs/tags/* ]]; then
            VERSION="${GITHUB_REF_NAME}"
          fi

          docker tag hotel-api "$IMAGE:$VERSION"
          docker tag hotel-api "$IMAGE:latest"
          docker push "$IMAGE:$VERSION"
          docker push "$IMAGE:latest"

      - name: Configurar homologacao
        run: |
          echo "APP_IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}:latest" >> $GITHUB_ENV
          echo "POSTGRES_USER=hotel" >> $GITHUB_ENV
          echo "POSTGRES_DB=hotel" >> $GITHUB_ENV
          echo "POSTGRES_PASSWORD=${{ secrets.STAGING_DB_PASSWORD }}" >> $GITHUB_ENV
          echo "APP_PORT=8000" >> $GITHUB_ENV

      - name: Fazer deploy
        run: |
          docker compose pull app
          docker compose up -d --no-build

      - name: Verificar aplicacao
        run: |
          for i in {1..12}; do
            if curl --fail http://localhost:8000/health; then
              echo "Deploy feito"
              exit 0
            fi
            sleep 5
          done

          docker compose logs
          exit 1

      - name: Encerrar containers
        if: always()
        run: docker compose down -v
